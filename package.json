{
  "name": "project-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate deploy --schema=automation-profile-manager/packages/prisma/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=automation-profile-manager/packages/prisma/prisma/schema.prisma",
    "db:seed": "npm run db:seed --prefix automation-profile-manager",
    "db:studio": "prisma studio --schema=automation-profile-manager/packages/prisma/prisma/schema.prisma"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "image-size": "^2.0.2",
    "next": "15.5.20",
    "next-auth": "^4.24.14",
    "prisma": "^6.19.3",
    "puppeteer": "^25.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-easy-crop": "^6.2.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/image-size": "^0.7.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
