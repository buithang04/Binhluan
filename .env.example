# ——— Domain công khai (ĐỔI 1 CHỖ KHI DEPLOY) ———
# Ví dụ production: APP_URL="https://apm.example.com"
APP_URL="http://localhost:3000"
# NextAuth bắt buộc cùng origin với APP_URL
NEXTAUTH_URL="http://localhost:3000"
# LAN test (máy khác cùng Wi‑Fi): set IP máy host, ví dụ http://192.168.1.236:3000
# LAN_APP_URL="http://192.168.1.236:3000"

NEXTAUTH_SECRET="change-me-to-a-long-random-string"
DATABASE_URL="postgresql://apm:apmsecret@127.0.0.1:5433/apm"
UPLOAD_DIR="./uploads"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# API Nest nội bộ (cùng máy / docker — không cần đổi khi có domain nginx)
APM_API_URL="http://127.0.0.1:4000/api"
# Để trống = browser dùng rewrite /apm-api (khuyến nghị)
NEXT_PUBLIC_APM_API_URL=""
# Server-side dispatch (cron/đăng bài) — bắt buộc khi NODE_ENV=production
APM_ADMIN_EMAIL="admin@apm.local"
APM_ADMIN_PASSWORD="Admin@123"

# Đăng ký công khai (mặc định tắt — admin tạo user tại /admin/users)
ALLOW_PUBLIC_REGISTER="false"
NEXT_PUBLIC_ALLOW_PUBLIC_REGISTER="false"
REVIEW_CRON_SECRET="change-me-cron-secret"
# Cửa sổ auto-đăng sau mốc lịch (phút). Quá cửa sổ = quá hạn → lập lại / Đăng tay.
REVIEW_SCHEDULE_GRACE_MINUTES=120
# Tick auto-enqueue (ms). Mặc định 30s.
REVIEW_DISPATCH_INTERVAL_MS=30000
# Worker BullMQ concurrency (automation-profile-manager worker) — khớp với dispatch batch
WORKER_CONCURRENCY=1
SESSION_IDLE_HOURS="24"
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"
# Chạy web production ổn định cho LAN (ít reload/chậm hơn dev): set khi start
# PowerShell: $env:WEB_MODE="prod"; npm run dev
